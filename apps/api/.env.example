NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/nyasa
JWT_SECRET=replace-with-a-long-random-secret
WEB_ORIGIN=http://localhost:5173

STORAGE_DRIVER=local
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=ap-south-1
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PAYMENT_PAGE_ID=
RAZORPAY_TEST_PAYMENT_PAGE_ID=
RAZORPAY_PAYMENT_PAGE_FAMILY_ID=

# Cashfree Payments. Keep sandbox until the membership-group account is approved.
CASHFREE_ENABLED=false
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2025-01-01

# Verified bank-transfer fallback. Keep disabled until the account details are reviewed.
BANK_CONTRIBUTION_ENABLED=false
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_IFSC=
BANK_UPI_ID=

# Optional dedicated Android bank-SMS forwarder.
BANK_SMS_INGEST_SECRET=
BANK_SMS_FAMILY_ID=
BANK_SMS_ALLOWED_SENDERS=UCOBANK
